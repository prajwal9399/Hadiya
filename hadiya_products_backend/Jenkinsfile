pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        AWS_ACCOUNT_ID = '812751451654'

        ECR_REPOSITORY = 'hadiya-backend'
        ECS_CLUSTER = 'hadiya-cluster'
        ECS_SERVICE = 'hadiya-backend-service'
        ECS_TASK_FAMILY = 'hadiya-backend-task'

        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Build Image') {
            steps {
                dir('hadiya_products_backend') {
                    sh '''
                        docker build \
                          -t ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_TAG} \
                          .
                    '''
                }
            }
        }

        stage('Login to ECR') {
            steps {
                sh '''
                    /usr/local/bin/aws ecr get-login-password \
                      --region ${AWS_REGION} | \
                    docker login \
                      --username AWS \
                      --password-stdin \
                      ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                '''
            }
        }

        stage('Push Image') {
            steps {
                sh '''
                    docker push \
                      ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_TAG}
                '''
            }
        }

        stage('Create Task Definition') {
            steps {
                sh '''
                    /usr/local/bin/aws ecs describe-task-definition \
                      --task-definition ${ECS_TASK_FAMILY} \
                      --region ${AWS_REGION} \
                      --query taskDefinition \
                      --output json > task-definition.json

                    IMAGE_URI="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_TAG}"

                    python3 - "$IMAGE_URI" <<'PY'
import json
import sys

image_uri = sys.argv[1]

with open("task-definition.json") as f:
    data = json.load(f)

data.pop("taskDefinitionArn", None)
data.pop("revision", None)
data.pop("status", None)
data.pop("requiresAttributes", None)
data.pop("compatibilities", None)
data.pop("registeredAt", None)
data.pop("registeredBy", None)

data["containerDefinitions"][0]["image"] = image_uri

with open("task-definition-new.json", "w") as f:
    json.dump(data, f)
PY

                    /usr/local/bin/aws ecs register-task-definition \
                      --cli-input-json file://task-definition-new.json \
                      --region ${AWS_REGION}
                '''
            }
        }

        stage('Deploy to ECS') {
            steps {
                sh '''
                    NEW_TASK_DEFINITION=$(
                        /usr/local/bin/aws ecs describe-task-definition \
                          --task-definition ${ECS_TASK_FAMILY} \
                          --region ${AWS_REGION} \
                          --query 'taskDefinition.taskDefinitionArn' \
                          --output text
                    )

                    echo "Deploying task definition: ${NEW_TASK_DEFINITION}"

                    /usr/local/bin/aws ecs update-service \
                      --cluster ${ECS_CLUSTER} \
                      --service ${ECS_SERVICE} \
                      --task-definition ${NEW_TASK_DEFINITION} \
                      --region ${AWS_REGION}
                '''
            }
        }

        stage('Wait for Deployment') {
            steps {
                sh '''
                    /usr/local/bin/aws ecs wait services-stable \
                      --cluster ${ECS_CLUSTER} \
                      --services ${ECS_SERVICE} \
                      --region ${AWS_REGION}
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    /usr/local/bin/aws ecs describe-services \
                      --cluster ${ECS_CLUSTER} \
                      --services ${ECS_SERVICE} \
                      --region ${AWS_REGION} \
                      --query 'services[0].{Running:runningCount,Desired:desiredCount,TaskDefinition:taskDefinition}' \
                      --output table
                '''
            }
        }
    }

    post {
        always {
            sh 'rm -f task-definition.json task-definition-new.json || true'
        }
    }
}
